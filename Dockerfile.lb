FROM rust:1.86-slim-bookworm AS builder

WORKDIR /build

COPY native/rinha-lb/Cargo.toml ./native/rinha-lb/
COPY native/rinha-lb/.cargo ./native/rinha-lb/.cargo
COPY native/rinha-lb/src ./native/rinha-lb/src

RUN cargo build --release --manifest-path native/rinha-lb/Cargo.toml --bin rinha-lb

FROM gcr.io/distroless/cc-debian12

LABEL org.opencontainers.image.source="https://github.com/GustavoQnt/rinha-de-backend-2026-node"
LABEL org.opencontainers.image.authors="Gustavo Quintela <gustavoqnt@github>"
LABEL org.opencontainers.image.title="rinha-2026-lb"
LABEL org.opencontainers.image.description="Rinha de Backend 2026 — TCP load balancer that hands accepted fds to upstream workers via SCM_RIGHTS over UDS"
LABEL org.opencontainers.image.licenses="MIT"

COPY --from=builder /build/native/rinha-lb/target/release/rinha-lb /rinha-lb

ENTRYPOINT ["/rinha-lb"]
